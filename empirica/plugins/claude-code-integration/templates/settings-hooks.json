{
  "_comment": "Add these hooks to ~/.claude/settings.json - replace PLUGIN_DIR with actual path. Mirrors what `empirica setup` registers (_register_all_hooks in setup_claude_code.py).",
  "_example_path": "~/.claude/plugins/local/empirica",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/sentinel-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/sentinel-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/ruling-shape.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/pre-compact.py",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/post-compact.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/ewm-protocol-loader.py",
            "timeout": 10,
            "allowFailure": true
          },
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/session-monitor-arm.py",
            "timeout": 30,
            "allowFailure": true
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/session-init.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/ewm-protocol-loader.py",
            "timeout": 10,
            "allowFailure": true
          },
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/session-monitor-arm.py",
            "timeout": 30,
            "allowFailure": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/session-end-postflight.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/curate-snapshots.py --output json",
            "timeout": 15,
            "allowFailure": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/subagent-start.py",
            "timeout": 10,
            "allowFailure": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/subagent-stop.py",
            "timeout": 15,
            "allowFailure": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/tool-router.py",
            "timeout": 30,
            "allowFailure": true
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/context-shift-tracker.py",
            "timeout": 30,
            "allowFailure": true
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/loop-install-pickup.py",
            "timeout": 30,
            "allowFailure": true
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/loop-uninstall-pickup.py",
            "timeout": 30,
            "allowFailure": true
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/listener-install-pickup.py",
            "timeout": 30,
            "allowFailure": true
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/listener-uninstall-pickup.py",
            "timeout": 30,
            "allowFailure": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/entity-extractor.py",
            "timeout": 30,
            "allowFailure": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/truncation-legibility.py",
            "timeout": 30,
            "allowFailure": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/task-completed.py",
            "timeout": 10,
            "allowFailure": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/tool-failure.py",
            "timeout": 30,
            "allowFailure": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 PLUGIN_DIR/hooks/transaction-enforcer.py",
            "timeout": 30,
            "allowFailure": true
          }
        ]
      }
    ]
  }
}
